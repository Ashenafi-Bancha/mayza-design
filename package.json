{
  "name": "mayza-design",
  "version": "1.0.0",
  "private": true,
  "description": "Mayza Design website and admin API (Node.js, Express, PostgreSQL)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node dev-server.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint .",
    "images": "node scripts/optimize-images.js",
    "content:verify": "python scripts/content-inventory.py --verify"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "qrcode": "1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "gsap": "3.13.0",
    "lenis": "1.3.4",
    "sharp": "0.33.5",
    "three": "0.170.0"
  }
}
